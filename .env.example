# Copy to .env and adjust. NEVER put real secrets in .env.example or in git.
# Every variable is optional: the defaults below are used when unset.

# --- App ---------------------------------------------------------------------
# Title shown in the API docs (/docs).
APP_TITLE=Voting System API

# --- Database ----------------------------------------------------------------
# SQLite file (default: backend/data/voting.db). PostgreSQL also works:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/votingdb
# DATABASE_URL=sqlite:///./data/voting.db

# --- Auth --------------------------------------------------------------------
# How long a sign-in lasts.
TOKEN_TTL_MINUTES=120
# Wrong passwords allowed before the account is locked...
MAX_FAILED_LOGINS=5
# ...and for how long.
LOCKOUT_MINUTES=15
# PBKDF2 iterations for password hashing. Keep 600000 in production; tests lower it.
PASSWORD_HASH_ITERATIONS=600000

# --- Simulated blockchain (docs/blockchain.md) ------------------------------
# Folder holding one sub-folder per simulated node (default: backend/data/nodes).
# CHAIN_DATA_DIR=./data/nodes
# Number of simulated validator nodes. A block needs a majority (N//2 + 1).
NODE_COUNT=3
# Seal a block once this many ballots are waiting...
BLOCK_SIZE=5
# ...or once the oldest waiting ballot has waited this long.
BLOCK_INTERVAL_SECONDS=30
# Leading hex zeros a block hash needs (proof-of-work). 3 = milliseconds; each +1 is ~16x slower.
POW_DIFFICULTY=3
# Run the background sealer / auto-tally loop. Tests set this to false.
SEALER_ENABLED=true
# How often the background loop wakes up.
SEALER_TICK_SECONDS=1
# Enables POST /chain/{id}/simulate/tamper for demos. NEVER true in a real election.
ENABLE_SIMULATION_TOOLS=false

# --- Ballot encryption -------------------------------------------------------
# Folder for per-election AES keys (default: backend/data/keys). Keep it private and backed up
# separately from the database.
# ELECTION_KEYS_DIR=./data/keys

# --- HTTP --------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser (the frontend dev server).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Max login / receipt-verify attempts per client IP per minute.
RATE_LIMIT_PER_MINUTE=20
